        "rateIndexMap": {
          "125": 0,
          "500": 1,
          "1000": 2,
          "2000": 3,
          "4000": 4,
          "8000": 5
        }
      }
    }
  },
  "protocol": {
    "queryBatteryTxHex": "11 06 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
    "queryDpiTxHex": "11 67 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
    "setDpiTxTemplate": "12 57 {stage} {stageCount} {dpiX_lo} {dpiX_hi} {dpiY_lo} {dpiY_hi}",
    "setPollingRateTxTemplate": "11 41 {rateIndex} 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
